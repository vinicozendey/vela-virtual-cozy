{
  "apphosting": [
    {
      "backendId": "vela-virtual-cozy-web-app",
      "rootDir": ".",
      "ignore": [
        "node_modules",
        ".git",
        ".firebase",
        "**/.env*",
        "**/.secret*",
        "**/*-debug.log",
        "web/dist",
        "**/*.log",
        "firepit-log.txt",
        "abacatepay.txt",
        ".next",
        "out",
        "**/node_modules",
        "**/*.tsbuildinfo",
        ".dependencies-before-next"
      ],
      "alwaysDeployFromSource": true
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "emulator-public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "api",
          "region": "southamerica-east1"
        }
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5050
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}
