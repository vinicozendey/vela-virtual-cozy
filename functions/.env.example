# Non-secret configuration. Keep project-specific values in an ignored .env.local or .env.<project-id>.
PUBLIC_BASE_URL=http://127.0.0.1:5173
RATE_LIMIT_SALT=replace-with-random-value
# Set true only after configuring EMAIL_API_KEY and EMAIL_FROM in Secret Manager.
ENABLE_PRODUCT_EMAILS=false
# ID or alias of the published Resend template for candle activation emails.
EMAIL_CANDLE_LIT_TEMPLATE_ID=vela-acesa
# Emulator only, for scripts/smoke-emulator.mjs:
# ABACATE_API_BASE=http://127.0.0.1:6060/v2

